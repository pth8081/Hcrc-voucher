# ==== Server ====
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
# Dung de ma hoa cac secret (token/API key/password) cua ket noi Core API luu trong DB
# (bang ApiConnections). Doi thanh 1 chuoi ngau nhien du dai, KHONG duoc mat/doi sau khi
# da co du lieu that vi se khong giai ma lai duoc cac secret da luu.
ENCRYPTION_KEY=change_this_to_a_long_random_secret_too

# ==== MSSQL (schema hien co: Users, Locations_Group, Locations_Detail, VOUCHER_SYNC, ...) ====
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=HCRC_Voucher
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ==== Core Voucher API (he thong phat hanh voucher, da co san) ====
# KHUYEN NGHI: cau hinh ket noi Core API truc tiep tren giao dien admin
# (menu "Ket noi API" -> /api-connection.html), khong can sua code/deploy lai.
# Cac bien duoi day CHI la fallback du phong, dung khi admin CHUA tao/kich hoat
# ket noi nao tren UI (xem src/services/coreVoucherService.js).
CORE_API_BASE_URL=https://core-voucher.example.com
CORE_API_KEY=replace_with_real_api_key
CORE_API_CHECK_PATH=/api/vouchers/check
CORE_API_REDEEM_PATH=/api/vouchers/redeem
CORE_API_TIMEOUT_MS=8000

# ==== Job tu dong dong bo lai voucher loi (VOUCHER_SYNC.Sync = 'N') ====
# Ap dung khi thu hoi thanh cong tai cho nhung KHONG goi duoc Core API luc do
# (mat mang/Core bao tri) - ban ghi duoc dua vao "hang doi" (Sync='N'), job nay
# chay dinh ky de gui lai. Xem src/services/syncRetryService.js.
SYNC_RETRY_ENABLED=true
SYNC_RETRY_INTERVAL_MINUTES=5
SYNC_RETRY_BATCH_SIZE=20
SYNC_RETRY_MAX_ATTEMPTS=20
