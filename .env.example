# ==== Server ====
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# ==== MSSQL (schema hien co: Users, Locations_Group, Locations_Detail, VOUCHER_SYNC, ...) ====
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=HCRC_Voucher
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ==== Core Voucher API (he thong phat hanh voucher, da co san) ====
# App nay CHI goi sang Core API de kiem tra / danh dau tieu voucher.
# Chinh lai path + field mapping trong src/services/coreVoucherService.js cho khop voi Core API that.
CORE_API_BASE_URL=https://core-voucher.example.com
CORE_API_KEY=replace_with_real_api_key
CORE_API_CHECK_PATH=/api/vouchers/check
CORE_API_REDEEM_PATH=/api/vouchers/redeem
CORE_API_TIMEOUT_MS=8000
